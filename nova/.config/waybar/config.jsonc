{
    "layer": "top",
    "position": "top",
    "output": [
        "*"
    ],

    "height": 34,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,

    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],

    "modules-left": [
        "group/pill#left"
    ],

    "group/pill#left": {
        "orientation": "inherit",
        "modules": [
            "cpu",
            "memory"
        ]
    },

    "modules-center": [
        "group/pill#center"
    ],

    "group/pill#center": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces",
            "hyprland/window"
        ]
    },

    "modules-right": [
        "group/pill#right-main",
        "group/pill#right-system"
    ],

    "group/pill#right-main": {
        "orientation": "inherit",
        "modules": [
            "network",
            "pulseaudio",
            "battery",
            "clock"
        ]
    },

    "group/pill#right-system": {
        "orientation": "inherit",
        "modules": [
            "custom/updates",
            "tray",
            "custom/power"
        ]
    }
}
